{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.json",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/*",
          "/**/*.svg"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-performance",
      "urls": [
        "/api/v1/equipment",
        "/api/v1/sedes",
        "/api/v1/technicians"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "5m",
        "strategy": "performance"
      }
    },
    {
      "name": "api-freshness",
      "urls": [
        "/api/v1/alerts/**",
        "/api/v1/maintenance-history/**",
        "/api/v1/permissions/**"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "1m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
